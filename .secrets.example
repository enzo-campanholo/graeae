# Copy to .secrets, fill in all five, then `pnpm run deploy`. .secrets is git-ignored.
# Delete .secrets after the first deploy: the Worker keeps the values.
# To change some secrets later, keep only their lines (a blank value is refused).

# At least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep a copy in your password manager: it is the owner's way back in.
SETUP_SECRET=

# The media server application (Cloudflare dashboard, Realtime, Serverless SFU):
# its App ID and App Secret.
SFU_APP_ID=
SFU_APP_SECRET=

# The relay key (Cloudflare dashboard, Realtime, TURN): its Turn Token ID and API Token.
TURN_KEY_ID=
TURN_KEY_TOKEN=
