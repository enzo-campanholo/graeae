# Copy to .secrets, fill in all five, then `pnpm run deploy`. .secrets is git-ignored.
# Delete .secrets after the first deploy: the Worker keeps the values.

# Generate with: openssl rand -base64 32
SETUP_SECRET=

# The media server application (Cloudflare dashboard, Realtime, SFU).
SFU_APP_ID=
SFU_APP_SECRET=

# The relay key (Cloudflare dashboard, Realtime, TURN).
TURN_KEY_ID=
TURN_KEY_TOKEN=
