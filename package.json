{
  "name": "graeae",
  "version": "0.0.0",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "dev": "vite dev",
    "dev:fake-media": "vite dev --mode fake-media",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "wrangler types --check && tsc -b && svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings",
    "types:generate": "wrangler types",
    "lint": "eslint .",
    "test": "vite build --mode fake-media && vitest run && playwright test",
    "test:browser": "vite build --mode fake-media && playwright test",
    "capture": "vite build --mode fake-media && playwright test -c scripts/capture/capture.config.ts",
    "perf": "vite build --mode fake-media && playwright test -c scripts/perf/perf.config.ts",
    "real-media": "node scripts/real-media/member.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.73.0",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
