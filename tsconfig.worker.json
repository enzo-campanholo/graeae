{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["./worker-configuration.d.ts", "vite/client", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/worker/**/*.ts", "src/instance/**/*.ts", "src/shared/**/*.ts", "test/**/*.ts"],
  // The Seam 2 tests and the loopback run in Node and a browser, not the Workers runtime.
  "exclude": ["test/browser/**", "test/loopback/**"]
}
