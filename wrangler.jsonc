{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A second instance on the same account deploys with `pnpm run deploy --name <other>`.
  "name": "graeae",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Only the free workers.dev hostname. A custom hostname is attached in the dashboard,
  // so this file never needs editing.
  "workers_dev": true,
  // No per-version preview addresses: the instance has one address, and an owner never
  // tries a version before deploying it.
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Every request reaches the Worker first, which alone decides what a visitor may see.
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "INSTANCE", "class_name": "Instance" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Instance"] }],
  // A deploy with any of these unset on the Worker and absent from the secrets file fails and names it.
  "secrets": {
    "required": ["SETUP_SECRET", "SFU_APP_ID", "SFU_APP_SECRET", "TURN_KEY_ID", "TURN_KEY_TOKEN"]
  }
}
